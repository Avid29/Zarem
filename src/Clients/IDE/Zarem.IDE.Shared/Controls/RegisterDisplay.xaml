<UserControl
    x:Class="Zarem.IDE.Controls.RegisterDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.IDE.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid Width="100">
        <TextBlock
            HorizontalAlignment="Left"
            FontSize="11"
            Opacity="0.6"
            Text="{x:Bind RegisterName, Mode=OneWay}" />
        <TextBlock
            HorizontalAlignment="Right"
            FontFamily="Consolas"
            FontWeight="Bold"
            Text="{x:Bind GetFormatedValue(Mode, Value), Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
