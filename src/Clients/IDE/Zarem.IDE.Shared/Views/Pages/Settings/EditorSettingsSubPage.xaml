<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.IDE.Views.Pages.Settings.EditorSettingsSubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clrschm="using:Zarem.IDE.Models.EditorConfig.ColorScheme"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:Zarem.IDE.Controls.CodeEditor"
    xmlns:helpers="using:Zarem.IDE.Helpers"
    xmlns:local="using:Zarem.IDE.Views.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:senums="using:Zarem.IDE.Services.Settings.Enums"
    mc:Ignorable="d">

    <UserControl.Resources>
        <editor:AssemblySyntaxColorScheme x:Name="SyntaxHighlighting" />
    </UserControl.Resources>

    <StackPanel>
        <StackPanel.ChildrenTransitions>
            <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="True" />
        </StackPanel.ChildrenTransitions>

        <editor:CodeEditor
            Height="250"
            AnnotationThreshold="{x:Bind ViewModel.AnnotationThreshold, Mode=OneWay}"
            Assembler="{x:Bind ViewModel.DemoAssembler, Mode=OneWay}"
            ColorScheme="{StaticResource SyntaxHighlighting}"
            CornerRadius="4"
            FlowDirection="LeftToRight"
            RealTimeAssembly="{x:Bind ViewModel.RealTimeAssembly, Mode=OneWay}"
            Text="{x:Bind DemoText}" />

        <!--<editor:AssemblyEditor
            Height="250"
            AnnotationThreshold="{x:Bind ViewModel.AnnotationThreshold, Mode=OneWay}"
            CornerRadius="4"
            FlowDirection="LeftToRight"
            RealTimeAssembly="{x:Bind ViewModel.RealTimeAssembly, Mode=OneWay}"
            SyntaxHighlightingTheme="{StaticResource SyntaxHighlighting}"
            Text="{x:Bind DemoText}" />-->

        <ctc:SettingsCard
            x:Uid="/Settings/RealTimeAssemblySC"
            Description="Should the editor continuously assemble the open file to show errors in real-time?"
            Header="Real-Time Assembly">
            <ToggleSwitch IsOn="{x:Bind ViewModel.RealTimeAssembly, Mode=TwoWay}" />
        </ctc:SettingsCard>

        <ctc:SettingsCard
            x:Uid="/Settings/AnnotationThresholdSC"
            Description="When should the editor show log messages as an annotation below the log."
            Header="Annotations Threshold"
            IsEnabled="{x:Bind ViewModel.RealTimeAssembly, Mode=OneWay}">
            <ComboBox ItemsSource="{x:Bind ViewModel.AnnotationThresholdOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.AnnotationThreshold, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="senums:AnnotationThreshold">
                        <TextBlock Text="{x:Bind helpers:LocalizationHelper.Localize((senums:AnnotationThreshold)), Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ctc:SettingsCard>

        <ctc:SettingsExpander
            x:Uid="/Settings/EditorColorSchemeSE"
            Description="Fully customize the color scheme of the text editor."
            Header="Color Scheme">
            <ctc:SettingsExpander.HeaderIcon>
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE2B1;" />
            </ctc:SettingsExpander.HeaderIcon>
            <ComboBox ItemsSource="{x:Bind ViewModel.EditorColorSchemeOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.EditorColorScheme, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="clrschm:EditorColorScheme">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ctc:SettingsExpander.Items>
                <ctc:SettingsCard
                    x:Uid="/Settings/LoadSchemeFromFileSC"
                    Description="Load an editor Color Scheme from a json file."
                    Header="Load from File">
                    <Button
                        x:Uid="/Settings/SelectSchemeFileBTN"
                        Command="{x:Bind ViewModel.LoadSchemeFromFileCommand, Mode=OneWay}"
                        Content="Select File" />
                </ctc:SettingsCard>
            </ctc:SettingsExpander.Items>
        </ctc:SettingsExpander>
    </StackPanel>
</UserControl>
