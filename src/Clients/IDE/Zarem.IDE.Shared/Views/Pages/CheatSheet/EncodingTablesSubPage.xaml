<UserControl
    x:Class="Zarem.IDE.Views.Pages.CheatSheet.EncodingTablesSubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cheat="using:Zarem.IDE.Controls.CheatSheet"
    xmlns:convert="using:Zarem.IDE.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.IDE.Views.Pages.CheatSheet"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mipsreg="using:Zarem.Mips.Models.Instructions.Enums.Registers"
    xmlns:tables="using:Zarem.Assembler.Helpers.Tables"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>

            <!--  Register Encoding Types  -->
            <SolidColorBrush x:Key="SavedRegister" Color="{ThemeResource Color5}" />
            <SolidColorBrush x:Key="TempRegister" Color="{ThemeResource Color1}" />
            <SolidColorBrush x:Key="ArgRegister" Color="{ThemeResource Color8}" />
            <SolidColorBrush x:Key="ReturnValueRegister" Color="{ThemeResource Color4}" />
            <SolidColorBrush x:Key="ReturnAddressRegister" Color="{ThemeResource Color2}" />
            <SolidColorBrush x:Key="EnvironmentRegister" Color="{ThemeResource Color6}" />
            <SolidColorBrush x:Key="KernelRegister" Color="{ThemeResource Color3}" />
            <SolidColorBrush x:Key="OtherRegister" Color="{ThemeResource Color7}" />

            <convert:RegisterEncodingColorConverter
                x:Key="RegisterEncodingColorConverter"
                ArgBrush="{StaticResource ArgRegister}"
                EnvironmentBrush="{StaticResource EnvironmentRegister}"
                KernelBrush="{StaticResource KernelRegister}"
                OtherBrush="{StaticResource OtherRegister}"
                ReturnAddressBrush="{StaticResource ReturnAddressRegister}"
                ReturnValueBrush="{StaticResource ReturnValueRegister}"
                SavedBrush="{StaticResource SavedRegister}"
                TempBrush="{StaticResource TempRegister}" />

            <DataTemplate x:Key="RegisterEncodingCellTemplate" x:DataType="mipsreg:MipsGpRegister">
                <Border
                    Margin="1"
                    Background="{x:Bind (mipsreg:MipsGpRegister), Converter={StaticResource RegisterEncodingColorConverter}}"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource HappyMonkey}"
                        FontSize="18"
                        Foreground="Black"
                        Text="{x:Bind tables:MipsRegisterTable.Instance.GetRegisterString((mipsreg:MipsGpRegister), mipsreg:MipsRegisterSet.GeneralPurpose)}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        Margin="48,16"
        HorizontalAlignment="Stretch"
        Spacing="4">
        <StackPanel.ChildrenTransitions>
            <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="True" />
        </StackPanel.ChildrenTransitions>

        <Expander HorizontalAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/GeneralPurposeRegisterEncodingTB"
                    Margin="8,0"
                    Text="General Purpose Register Encoding"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <cheat:EncodingTableDisplay
                x:Name="RegisterEncodingTable"
                HorizontalAlignment="Center"
                CellTemplate="{StaticResource RegisterEncodingCellTemplate}"
                Columns="4"
                FontFamily="{StaticResource HappyMonkey}"
                Rows="8" />
        </Expander>
    </StackPanel>
</UserControl>
