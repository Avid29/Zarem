<UserControl
    x:Class="Zarem.IDE.Views.Pages.CheatSheet.UsagePatternsSubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cheat="using:Zarem.IDE.Controls.CheatSheet"
    xmlns:collections="using:CommunityToolkit.Mvvm.Collections"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mdata="using:Zarem.Mips.Assembler.Models.Meta"
    xmlns:palette="using:Zarem.IDE.Controls.CheatSheet.Palettes"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  Instruction Types  -->
            <SolidColorBrush x:Key="RInst" Color="{ThemeResource Color1}" />
            <SolidColorBrush x:Key="R2Inst" Color="{ThemeResource Color2}" />
            <SolidColorBrush x:Key="IInst" Color="{ThemeResource Color5}" />
            <SolidColorBrush x:Key="JInst" Color="{ThemeResource Color4}" />
            <SolidColorBrush x:Key="RegImmInst" Color="{ThemeResource Color8}" />
            <SolidColorBrush x:Key="CoProc0Inst" Color="{ThemeResource Color3}" />
            <SolidColorBrush x:Key="CoProc1Inst" Color="{ThemeResource Color3}" />
            <SolidColorBrush x:Key="CoProc1XInst" Color="{ThemeResource Color7}" />
            <SolidColorBrush x:Key="CoProcIInst" Color="{ThemeResource Color6}" />

            <!--  Argument Types  -->
            <SolidColorBrush x:Key="GPRArg" Color="{ThemeResource Color1}" />
            <SolidColorBrush x:Key="CPRArg" Color="{ThemeResource Color2}" />
            <SolidColorBrush x:Key="ImmArg" Color="{ThemeResource Color3}" />
            <SolidColorBrush x:Key="FormatArg" Color="{ThemeResource Color8}" />
            <SolidColorBrush x:Key="MiscArg" Color="{ThemeResource Color7}" />

            <palette:InstructionTypeBrushPalette
                x:Key="InstructionBrushPalette"
                CoProcessor0="{StaticResource CoProc0Inst}"
                CoProcessor1="{StaticResource CoProc1Inst}"
                IType="{StaticResource IInst}"
                JType="{StaticResource JInst}"
                R2Type="{StaticResource R2Inst}"
                RType="{StaticResource RInst}"
                RegImmediate="{StaticResource RegImmInst}" />

            <palette:ArgumentBrushPalette
                x:Key="ArgumentBrushPalette"
                CPRegisterBrush="{StaticResource CPRArg}"
                FormatBrush="{StaticResource FormatArg}"
                GPRegisterBrush="{StaticResource GPRArg}"
                ImmediateValueBrush="{StaticResource ImmArg}"
                MiscArgBrush="{StaticResource MiscArg}" />

            <DataTemplate x:Key="InstructionEntryTemplate" x:DataType="mdata:MipsInstructionMetaBase">
                <cheat:UsagePatternDisplay
                    ArgumentBrushPalette="{StaticResource ArgumentBrushPalette}"
                    FontFamily="Cascadia Code"
                    FontSize="14"
                    InstructionBrushPalette="{StaticResource InstructionBrushPalette}"
                    Metadata="{x:Bind}" />
            </DataTemplate>

            <DataTemplate x:Key="InstructionGroupHeaderTemplate" x:DataType="collections:IReadOnlyObservableGroup">
                <TextBlock
                    FontFamily="{StaticResource HappyMonkey}"
                    FontSize="16"
                    Foreground="{ThemeResource HeaderForegroundBrush}"
                    Text="{x:Bind Key}" />
            </DataTemplate>

            <Style TargetType="ListViewHeaderItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="8,12,8,4" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewHeaderItem">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>

            <CollectionViewSource
                x:Name="CommonInstructionsViewSource"
                IsSourceGrouped="True"
                Source="{x:Bind ViewModel.CommonInstructions, Mode=OneWay}" />
            <CollectionViewSource
                x:Name="FloatInstructionsViewSource"
                IsSourceGrouped="True"
                Source="{x:Bind ViewModel.FloatInstructions, Mode=OneWay}" />
            <CollectionViewSource
                x:Name="CoProc0InstructionsViewSource"
                IsSourceGrouped="True"
                Source="{x:Bind ViewModel.CoProc0Instructions, Mode=OneWay}" />
            <CollectionViewSource
                x:Name="SpecializedInstructionsViewSource"
                IsSourceGrouped="True"
                Source="{x:Bind ViewModel.Specialized0Instructions, Mode=OneWay}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        Margin="48,16"
        HorizontalAlignment="Stretch"
        Spacing="4">
        <StackPanel.ChildrenTransitions>
            <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="True" />
        </StackPanel.ChildrenTransitions>

        <Expander HorizontalAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/CommonInstructionsTB"
                    Margin="8,0"
                    Text="Common Instructions"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <ListView
                ItemTemplate="{StaticResource InstructionEntryTemplate}"
                ItemsSource="{x:Bind CommonInstructionsViewSource.View, Mode=OneWay}"
                ScrollViewer.IsHorizontalRailEnabled="False"
                ScrollViewer.IsVerticalRailEnabled="False"
                SelectionMode="None">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource InstructionGroupHeaderTemplate}" HidesIfEmpty="True" />
                </ListView.GroupStyle>
            </ListView>
        </Expander>
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/CoProc0InstructionsTB"
                    Margin="8,0"
                    Text="CoProcessor0 Instructions"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <ListView
                ItemTemplate="{StaticResource InstructionEntryTemplate}"
                ItemsSource="{x:Bind CoProc0InstructionsViewSource.View, Mode=OneWay}"
                SelectionMode="None">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource InstructionGroupHeaderTemplate}" HidesIfEmpty="True" />
                </ListView.GroupStyle>
            </ListView>
        </Expander>
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/FloatInstructionsTB"
                    Margin="8,0"
                    Text="Floating-Point Instructions"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <ListView
                ItemTemplate="{StaticResource InstructionEntryTemplate}"
                ItemsSource="{x:Bind FloatInstructionsViewSource.View, Mode=OneWay}"
                SelectionMode="None">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource InstructionGroupHeaderTemplate}" HidesIfEmpty="True" />
                </ListView.GroupStyle>
            </ListView>
        </Expander>
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/SpecializedInstructionsTB"
                    Margin="8,0"
                    Text="Specialized Instructions"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <ListView
                ItemTemplate="{StaticResource InstructionEntryTemplate}"
                ItemsSource="{x:Bind SpecializedInstructionsViewSource.View, Mode=OneWay}"
                SelectionMode="None">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource InstructionGroupHeaderTemplate}" HidesIfEmpty="True" />
                </ListView.GroupStyle>
            </ListView>
        </Expander>
    </StackPanel>
</UserControl>
