<?xml version="1.0" encoding="utf-8" ?>
<zarem:ZaremAppBase
    x:Class="Zarem.IDE.ZaremIDEApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="using:Zarem.Converters"
    xmlns:local="using:Zarem.IDE"
    xmlns:zarem="using:Zarem">
    <zarem:ZaremAppBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <ResourceDictionary Source="Resources/Brushes.xaml" />
                <ResourceDictionary Source="Resources/Fonts.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />

                <ResourceDictionary Source="Controls/CodeEditor/CodeEditor.xaml" />
                <ResourceDictionary Source="Controls/CodeEditor/Scintilla/ScintillaCodeEditor.xaml" />
                <ResourceDictionary Source="Controls/CodeEditor/Zarem/ZaremCodeEditor.xaml" />
                <ResourceDictionary Source="Controls/HexViewer/HexViewer.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:StringLocalizeConverter x:Key="StringLocalizeConverter" />
        </ResourceDictionary>
    </zarem:ZaremAppBase.Resources>
</zarem:ZaremAppBase>
