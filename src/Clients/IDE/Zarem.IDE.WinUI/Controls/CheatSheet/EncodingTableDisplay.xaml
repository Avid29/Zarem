<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.IDE.Controls.CheatSheet.EncodingTableDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.IDE.Controls.CheatSheet"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="using:System"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Name="LabelTemplate" x:DataType="local:Label">
            <Grid Width="64" Height="32">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="{x:Bind local:EncodingTableDisplay.GetLabel(Index, Count)}" />
                <TextBlock
                    Margin="2,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Opacity=".6"
                    Text="{x:Bind Index}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="TableGrid" FlowDirection="LeftToRight" />

</UserControl>
