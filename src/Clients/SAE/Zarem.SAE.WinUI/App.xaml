<?xml version="1.0" encoding="utf-8" ?>
<zarem:ZaremAppBase
    x:Class="Zarem.SAE.ZaremSAEApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="using:Zarem.Converters"
    xmlns:local="using:Zarem.SAE"
    xmlns:zarem="using:Zarem">
    <zarem:ZaremAppBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <ResourceDictionary Source="Resources/Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:StringLocalizeConverter x:Key="StringLocalizeConverter" />
        </ResourceDictionary>
    </zarem:ZaremAppBase.Resources>
</zarem:ZaremAppBase>
