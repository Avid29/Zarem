<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.SAE.Views.Shell.OverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.SAE.Views.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:Zarem.SAE.Views.Pages"
    xmlns:selectors="using:Zarem.SAE.Selectors"
    xmlns:spages="using:Zarem.SAE.Views.Pages.Settings"
    xmlns:svmv="using:Zarem.SAE.ViewModels.Pages.Settings"
    xmlns:vmv="using:Zarem.SAE.ViewModels.Pages"
    Visibility="{x:Bind ViewModel.IsPageOpen, Mode=OneWay}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <selectors:PageTemplateSelector x:Key="PageTemplateSelector">
            <selectors:PageTemplateSelector.AboutPageTemplate>
                <DataTemplate x:DataType="vmv:SaeAboutPageViewModel">
                    <pages:AboutPage ViewModel="{x:Bind Mode=OneWay}" />
                </DataTemplate>
            </selectors:PageTemplateSelector.AboutPageTemplate>
            <selectors:PageTemplateSelector.SettingsPageTemplate>
                <DataTemplate x:DataType="svmv:SaeSettingsPageViewModel">
                    <spages:SettingsPage ViewModel="{x:Bind Mode=OneWay}" />
                </DataTemplate>
            </selectors:PageTemplateSelector.SettingsPageTemplate>
        </selectors:PageTemplateSelector>
    </UserControl.Resources>

    <ContentControl
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Content="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"
        ContentTemplateSelector="{StaticResource PageTemplateSelector}" />
</UserControl>
