<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!--  Background Colors  -->
            <Color x:Key="TitleBarBackgroundColor">#222024</Color>
            <Color x:Key="TabViewBackgroundColor">#131215</Color>
            <Color x:Key="PrimaryBackgroundColor">#131215</Color>

            <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{ThemeResource PrimaryBackgroundColor}" />
            <AcrylicBrush
                x:Key="TitleBarBackgroundBrush"
                TintColor="{ThemeResource TitleBarBackgroundColor}"
                TintOpacity="0.8" />
            <AcrylicBrush
                x:Key="TabViewBackgroundBrush"
                TintColor="{ThemeResource TabViewBackgroundColor}"
                TintOpacity="0.8" />
            <AcrylicBrush
                x:Key="SideBarBackgroundBrush"
                TintColor="#161518"
                TintOpacity="0.5" />
            <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#222024" />

            <!--  Colors  -->
            <Color x:Key="Color1">#FE8482</Color>
            <Color x:Key="Color2">#FFC47A</Color>
            <Color x:Key="Color3">#F8FC8B</Color>
            <Color x:Key="Color4">#A7FA95</Color>
            <Color x:Key="Color5">#73EEFD</Color>
            <Color x:Key="Color6">#77A7FD</Color>
            <Color x:Key="Color7">#9B88FC</Color>
            <Color x:Key="Color8">#FA9EF6</Color>

        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <!--  Background Colors  -->
            <Color x:Key="TitleBarBackgroundColor">#E2E1E0</Color>
            <Color x:Key="TabViewBackgroundColor">#E7E6E4</Color>
            <Color x:Key="PrimaryBackgroundColor">#F5F3F2</Color>
            <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{ThemeResource PrimaryBackgroundColor}" />
            <AcrylicBrush
                x:Key="TitleBarBackgroundBrush"
                TintColor="{ThemeResource TitleBarBackgroundColor}"
                TintOpacity="0.8" />
            <AcrylicBrush
                x:Key="TabViewBackgroundBrush"
                TintColor="{ThemeResource TabViewBackgroundColor}"
                TintOpacity="0.8" />
            <AcrylicBrush
                x:Key="SideBarBackgroundBrush"
                TintColor="#F0F0F0"
                TintOpacity="0.75" />
            <AcrylicBrush
                x:Key="FooterBackgroundBrush"
                TintColor="#F0F0F0"
                TintOpacity="0.75" />

            <!--  Colors  -->
            <Color x:Key="Color1">#7e0301</Color>
            <Color x:Key="Color2">#804600</Color>
            <Color x:Key="Color3">#909504</Color>
            <Color x:Key="Color4">#166105</Color>
            <Color x:Key="Color5">#028597</Color>
            <Color x:Key="Color6">#022d7e</Color>
            <Color x:Key="Color7">#17037c</Color>
            <Color x:Key="Color8">#61055c</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Colors  -->
    <Color x:Key="Color1Bright">#FE8482</Color>
    <Color x:Key="Color2Bright">#FFC47A</Color>
    <Color x:Key="Color3Bright">#F8FC8B</Color>
    <Color x:Key="Color4Bright">#A7FA95</Color>
    <Color x:Key="Color5Bright">#73EEFD</Color>
    <Color x:Key="Color6Bright">#77A7FD</Color>
    <Color x:Key="Color7Bright">#9B88FC</Color>
    <Color x:Key="Color8Bright">#FA9EF6</Color>

    <!--  Zarem Colors  -->
    <Color x:Key="ZaremBlueColor">#034AC9</Color>
    <Color x:Key="ZaremPurpleColor">#5838FA</Color>

</ResourceDictionary>
