<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Zarem.WinUI.Services.Popup.TextInputPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zarem.WinUI.Services.Popup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    IsPrimaryButtonEnabled="{x:Bind InputTextBox.(ui:TextBoxExtensions.IsValid), Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="10">
        <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap"/>
        <TextBox x:Name="InputTextBox"
                 Text="{x:Bind Text, Mode=TwoWay}"
                 PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}" 
                 ui:TextBoxExtensions.Regex="{x:Bind ValidatonRegex, Mode=OneWay}"/>
    </StackPanel>
</ContentDialog>
