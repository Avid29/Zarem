<?xml version="1.0" encoding="utf-8" ?>
<local:ZaremWindow
    x:Class="Zarem.IDE.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.IDE.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:Zarem.IDE.Views.Pages"
    xmlns:shell="using:Zarem.IDE.Views.Shell"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition
                Height="24"
                MinHeight="28"
                MaxHeight="600" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
                Width="280"
                MinWidth="50"
                MaxWidth="600" />
        </Grid.ColumnDefinitions>

        <!--  Title Bar  -->
        <shell:TitleBar DataContext="{x:Bind ViewModel, Mode=OneWay}" />

        <!--  Status Bar  -->
        <shell:StatusBar Grid.Row="3" Grid.ColumnSpan="2" />

        <!--  Content View  -->
        <shell:PanelView
            x:Name="MainPanel"
            Grid.Row="1"
            Margin="0,0,0,14"
            DataContext="{x:Bind ViewModel.PanelViewModel, Mode=OneWay}" />

        <!--  Error List / Register Viewer  -->
        <pages:ErrorList Grid.Row="2" Visibility="{x:Bind InvertVisibile(ViewModel.MainViewModel.StatusViewModel.IsRunning), Mode=OneWay}" />
        <pages:RegisterViewer Grid.Row="2" Visibility="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsRunning, Mode=OneWay}" />

        <!--  Explorer  -->
        <Border
            Grid.RowSpan="3"
            Grid.Column="1"
            Background="{ThemeResource SideBarBackgroundBrush}" />
        <pages:Explorer
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="10,0,0,0" />

        <!--  Row Splitter  -->
        <ctc:GridSplitter
            Grid.Row="1"
            VerticalAlignment="Bottom"
            ResizeBehavior="BasedOnAlignment">
            <ctc:GridSplitter.RenderTransform>
                <TranslateTransform Y="0" />
            </ctc:GridSplitter.RenderTransform>
        </ctc:GridSplitter>

        <!--  Column Splitter  -->
        <ctc:GridSplitter
            Grid.RowSpan="3"
            Grid.Column="1"
            HorizontalAlignment="Left"
            ResizeBehavior="BasedOnAlignment">
            <ctc:GridSplitter.RenderTransform>
                <TranslateTransform X="0" />
            </ctc:GridSplitter.RenderTransform>
        </ctc:GridSplitter>
    </Grid>
</local:ZaremWindow>
