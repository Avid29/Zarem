<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zarem.IDE.Controls.CodeEditor"
    xmlns:scintilla="using:Zarem.IDE.Controls.CodeEditor.Scintilla"
    xmlns:zeditor="using:Zarem.IDE.Controls.CodeEditor.Zarem">

    <Style x:Key="ZaremCodeEditorStyle" TargetType="local:CodeEditor">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CodeEditor">
                    <zeditor:ZaremCodeEditor
                        x:Name="PART_ICodeEditor"
                        AnnotationThreshold="{TemplateBinding AnnotationThreshold}"
                        ColorScheme="{TemplateBinding ColorScheme}"
                        Column="{Binding Column, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        ExecutingLocation="{TemplateBinding ExecutingLocation}"
                        Line="{Binding Line, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Zoom="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScintillaCodeEditorStyle" TargetType="local:CodeEditor">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CodeEditor">
                    <scintilla:ScintillaCodeEditor
                        x:Name="PART_ICodeEditor"
                        AnnotationThreshold="{TemplateBinding AnnotationThreshold}"
                        ColorScheme="{TemplateBinding ColorScheme}"
                        Column="{Binding Column, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        ExecutingLocation="{TemplateBinding ExecutingLocation}"
                        Line="{Binding Line, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Zoom="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ZaremCodeEditorStyle}" TargetType="local:CodeEditor" />

</ResourceDictionary>
