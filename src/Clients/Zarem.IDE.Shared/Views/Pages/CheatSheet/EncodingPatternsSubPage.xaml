<UserControl
    x:Class="Zarem.IDE.Views.Pages.CheatSheet.EncodingPatternsSubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cheat="using:Zarem.IDE.Controls.CheatSheet"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.IDE.Views.Pages.CheatSheet"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Zarem.IDE.Models.CheatSheet"
    xmlns:palette="using:Zarem.IDE.Controls.CheatSheet.Palettes"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  Sections Types  -->
            <SolidColorBrush x:Key="OpCodeSection" Color="{ThemeResource Color4Bright}" />
            <SolidColorBrush x:Key="FuncCodeSection" Color="{ThemeResource Color5Bright}" />
            <SolidColorBrush x:Key="RegFuncCodeSection" Color="{ThemeResource Color8Bright}" />
            <SolidColorBrush x:Key="GPRSection" Color="{ThemeResource Color1Bright}" />
            <SolidColorBrush x:Key="CPRSection" Color="{ThemeResource Color2Bright}" />
            <SolidColorBrush x:Key="ImmSection" Color="{ThemeResource Color3Bright}" />
            <SolidColorBrush x:Key="FormatSection" Color="{ThemeResource Color7Bright}" />
            <LinearGradientBrush x:Key="GeneralOrCoRegisterSection" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStopCollection>
                    <GradientStop Offset="0" Color="{ThemeResource Color1Bright}" />
                    <GradientStop Offset="1" Color="{ThemeResource Color2Bright}" />
                </GradientStopCollection>
            </LinearGradientBrush>

            <palette:EncodingPatternSectionBrushPalette
                x:Key="SectionBrushPalette"
                CPRegisterBrush="{StaticResource CPRSection}"
                FormatBrush="{StaticResource FormatSection}"
                FuncCodeBrush="{StaticResource FuncCodeSection}"
                GPRegisterBrush="{StaticResource GPRSection}"
                GeneralOrCoRegisterBrush="{StaticResource GeneralOrCoRegisterSection}"
                ImmediateValueBrush="{StaticResource ImmSection}"
                OpCodeBrush="{StaticResource OpCodeSection}"
                RegisterFuncCodeBrush="{StaticResource RegFuncCodeSection}" />

            <DataTemplate x:Key="EncodingPatternDisplayTemplate" x:DataType="models:EncodingPattern">
                <StackPanel>
                    <TextBlock
                        Margin="0,2"
                        FontFamily="{StaticResource HappyMonkey}"
                        Foreground="{ThemeResource HeaderForegroundBrush}"
                        Text="{x:Bind Name}" />
                    <cheat:EncodingPatternDisplay
                        EncodingPattern="{x:Bind}"
                        FontFamily="{StaticResource HappyMonkey}"
                        SectionBrushPalette="{StaticResource SectionBrushPalette}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        Margin="48,16"
        HorizontalAlignment="Stretch"
        Spacing="4">
        <StackPanel.ChildrenTransitions>
            <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="True" />
        </StackPanel.ChildrenTransitions>

        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/PrimaryInstructionTypePatternsTB"
                    Margin="8,0"
                    Text="Primary Instruction Types Encoding Patterns"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <ItemsRepeater
                Margin="24,0"
                ItemTemplate="{StaticResource EncodingPatternDisplayTemplate}"
                ItemsSource="{x:Bind ViewModel.PrimaryEncodingPatterns, Mode=OneWay}" />
        </Expander>
        <Expander HorizontalAlignment="Stretch"  HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/CoProc0InstructionTypePatternsTB"
                    Margin="8,0"
                    Text="CoProcessor0 Instruction Types Encoding Patterns"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <ItemsRepeater
                Margin="24,0"
                ItemTemplate="{StaticResource EncodingPatternDisplayTemplate}"
                ItemsSource="{x:Bind ViewModel.CoProcessor0Patterns, Mode=OneWay}" />
        </Expander>
        <Expander HorizontalAlignment="Stretch"  HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/CoProc1InstructionTypePatternsTB"
                    Margin="8,0"
                    Text="Floating-Point CoProcessor Instruction Types Encoding Patterns"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <ItemsRepeater
                Margin="24,0"
                ItemTemplate="{StaticResource EncodingPatternDisplayTemplate}"
                ItemsSource="{x:Bind ViewModel.CoProcessor1Patterns, Mode=OneWay}" />
        </Expander>
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <TextBlock
                    x:Uid="/CheatSheet/UniqueInstructionPatternsTB"
                    Margin="8,0"
                    Text="Unique Instruction Encoding Patterns"
                    TextTrimming="CharacterEllipsis" />
            </Expander.Header>
            <ItemsRepeater
                Margin="24,0"
                ItemTemplate="{StaticResource EncodingPatternDisplayTemplate}"
                ItemsSource="{x:Bind ViewModel.UniquePatterns, Mode=OneWay}" />
        </Expander>
    </StackPanel>
</UserControl>
