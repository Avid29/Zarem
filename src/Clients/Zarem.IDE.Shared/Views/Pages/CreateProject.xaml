<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.IDE.Views.Pages.CreateProject"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:descriptors="using:Zarem.Descriptors"
    xmlns:helpers="using:Zarem.IDE.Helpers"
    xmlns:ienums="using:Zarem.Models.Instructions.Enums"
    xmlns:local="using:Zarem.IDE.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="/Pages/CreateProject/CreateANewProjectTB"
            Margin="32,16"
            FontSize="26"
            Text="Create a new project"
            TextTrimming="CharacterEllipsis" />

        <ScrollViewer
            Grid.Row="1"
            Margin="32,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0" Spacing="16">
                <TextBox
                    x:Uid="/Pages/CreateProject/ProjectNameTBox"
                    Header="Project Name"
                    PlaceholderText="Cool Project Name"
                    Text="{x:Bind ViewModel.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Uid="/Pages/CreateProject/FolderTBox"
                        Header="Folder"
                        IsReadOnly="True"
                        PlaceholderText="Path"
                        Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}" />
                    <Button
                        x:Uid="/Pages/CreateProject/SelectFolderBTN"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.SelectFolderCommand, Mode=OneWay}"
                        Content="Select Folder" />
                </Grid>

                <Grid Margin="4,-8,0,0">
                    <TextBlock
                        FontSize="12"
                        Opacity=".8"
                        Text="{x:Bind ViewModel.CreationPath, Converter={StaticResource StringLocalizeConverter}, ConverterParameter='/Pages/CreateProject/CreationPath', Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ReadyToCreate, Mode=OneWay}" />

                    <TextBlock
                        x:Uid="/Pages/CreateProject/ConflictingProjectTB"
                        FontSize="12"
                        Opacity=".8"
                        Text="A project with that name already exists in this folder."
                        Visibility="{x:Bind ViewModel.NameConflict, Mode=OneWay}" />
                </Grid>

                <ComboBox
                    x:Uid="/Pages/CreateProject/ArchitectureCB"
                    Header="Architecture"
                    ItemsSource="{x:Bind ViewModel.AvailableArchitectures, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.Architecture, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="descriptors:IArchitectureDescriptor">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox
                    x:Uid="/Pages/CreateProject/ModuleFormatCB"
                    Header="Module Format"
                    ItemsSource="{x:Bind ViewModel.AvailableModuleFormats, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.ModuleFormat, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="descriptors:IModuleFormatDescriptor">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="64,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Uid="CreateBTN"
                Command="{x:Bind ViewModel.CreateProjectCommand, Mode=OneWay}"
                Content="Create"
                IsEnabled="{x:Bind ViewModel.ReadyToCreate, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Uid="CancelBTN"
                Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                Content="Cancel" />
        </StackPanel>
    </Grid>
</UserControl>
