<UserControl
    x:Class="Zarem.IDE.Views.Pages.RegisterViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindable="using:Zarem.IDE.Bindables"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.IDE.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <GridView ItemsSource="{x:Bind ViewModel.Registers, Mode=OneWay}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="bindable:BindableRegister">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Opacity=".5" Text="{x:Bind RegisterName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Value, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>
