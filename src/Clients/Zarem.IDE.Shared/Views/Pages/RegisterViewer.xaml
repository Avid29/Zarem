<UserControl
    x:Class="Zarem.IDE.Views.Pages.RegisterViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindable="using:Zarem.IDE.Bindables"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:Zarem.IDE.Models.Enums"
    xmlns:local="using:Zarem.IDE.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <GridView
        Padding="12"
        IsItemClickEnabled="True"
        ItemClick="GridView_ItemClick"
        ItemsSource="{x:Bind ViewModel.Registers, Mode=OneWay}"
        SelectionMode="None">
        <GridView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid MaximumRowsOrColumns="16" Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </GridView.ItemsPanel>

        <GridView.ItemTemplate>
            <DataTemplate x:DataType="bindable:BindableRegister">
                <Border
                    Margin="2"
                    Padding="8,4"
                    Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                    CornerRadius="4">
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Uid="/RegisterView/DecimalModeMFI"
                                Click="MenuFlyoutItem_Click"
                                Tag="{x:Bind enums:RegisterDisplayMode.Decimal}"
                                Text="Decimal">
                                <MenuFlyoutItem.Icon>
                                    <ImageIcon Source="{StaticResource DecimalDisplayModeIcon}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="/RegisterView/HexadecimalModeMFI"
                                Click="MenuFlyoutItem_Click"
                                Tag="{x:Bind enums:RegisterDisplayMode.Hex}"
                                Text="Hexadecimal">
                                <MenuFlyoutItem.Icon>
                                    <ImageIcon Source="{StaticResource HexadecimalDisplayModeIcon}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="/RegisterView/LabelOffsetModeMFI"
                                Click="MenuFlyoutItem_Click"
                                IsEnabled="False"
                                Tag="{x:Bind enums:RegisterDisplayMode.Label}"
                                Text="Label">
                                <MenuFlyoutItem.Icon>
                                    <ImageIcon Source="{StaticResource LabelDisplayModeIcon}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="/RegisterView/StringModeMFI"
                                Click="MenuFlyoutItem_Click"
                                IsEnabled="False"
                                Tag="{x:Bind enums:RegisterDisplayMode.String}"
                                Text="String">
                                <MenuFlyoutItem.Icon>
                                    <ImageIcon Source="{StaticResource StringDisplayModeIcon}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <Grid Width="100">
                        <TextBlock
                            HorizontalAlignment="Left"
                            FontSize="11"
                            Opacity="0.6"
                            Text="{x:Bind RegisterName, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="Consolas"
                            FontWeight="Bold"
                            Text="{x:Bind local:RegisterViewer.GetFormatedValue(DisplayMode, Value), Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </GridView.ItemTemplate>

        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Grid
                                x:Name="RootGrid"
                                Background="Transparent"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <PointerUpThemeAnimation TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    To="1.04"
                                                    Duration="0:0:0.15" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    To="1.04"
                                                    Duration="0:0:0.15" />
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    To="0.98"
                                                    Duration="0:0:0.05" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    To="0.98"
                                                    Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </GridView.ItemContainerStyle>
    </GridView>
</UserControl>
