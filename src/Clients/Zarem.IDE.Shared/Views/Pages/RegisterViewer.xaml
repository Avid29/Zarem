<UserControl
    x:Class="Zarem.IDE.Views.Pages.RegisterViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindable="using:Zarem.IDE.Bindables"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.IDE.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <GridView
        Padding="12"
        IsItemClickEnabled="True"
        ItemClick="GridView_ItemClick"
        ItemsSource="{x:Bind ViewModel.Registers, Mode=OneWay}"
        SelectionMode="None">
        <GridView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid MaximumRowsOrColumns="16" Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </GridView.ItemsPanel>

        <GridView.ItemTemplate>
            <DataTemplate x:DataType="bindable:BindableRegister">
                <Border
                    Margin="2"
                    Padding="8,4"
                    Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}"
                    CornerRadius="4">
                    <Grid Width="100">
                        <TextBlock
                            HorizontalAlignment="Left"
                            FontSize="11"
                            Opacity="0.6"
                            Text="{x:Bind RegisterName, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="Consolas"
                            FontWeight="Bold"
                            Text="{x:Bind local:RegisterViewer.GetFormatedValue(DisplayMode, Value), Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>
