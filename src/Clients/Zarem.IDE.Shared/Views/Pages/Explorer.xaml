<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.IDE.Views.Pages.Explorer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="using:Zarem.IDE.Converters"
    xmlns:ctrls="using:Zarem.IDE.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:files="using:Zarem.Bindables.Files"
    xmlns:local="using:Zarem.IDE.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selector="using:Zarem.IDE.Selectors"
    mc:Ignorable="d">

    <UserControl.Resources>
        <convert:FileTypeIconConverter
            x:Key="FileTypeIconConverter"
            Assembly="{StaticResource AsmFileIcon}"
            Default="{StaticResource FileIcon}"
            Object="{StaticResource ObjFileIcon}"
            Project="{StaticResource AppIconSmall}" />

        <DataTemplate x:Key="FolderTemplate" x:DataType="files:BindableFolder">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                DoubleTapped="FolderDoubleTapped"
                HasUnrealizedChildren="{x:Bind ChildrenNotLoaded, Mode=OneWay}"
                ItemsSource="{x:Bind Children, Mode=OneWay}"
                Loaded="TreeViewItem_Loaded">
                <TreeViewItem.ContextFlyout>
                    <MenuFlyout>
                        <!--  Add  -->
                        <MenuFlyoutSubItem x:Uid="/Explorer/Flyout/AddMFSI" Text="Add">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                            </MenuFlyoutSubItem.Icon>
                            <!--  File  -->
                            <MenuFlyoutItem
                                x:Uid="/Explorer/Flyout/NewFileMFI"
                                Command="{x:Bind CreateChildFileCommand, Mode=OneWay}"
                                Text="New File" />
                            <MenuFlyoutItem
                                x:Uid="/Explorer/Flyout/ExistingFileMFI"
                                IsEnabled="False"
                                Text="Existing File" />
                            <MenuFlyoutSeparator />

                            <!--  Folder  -->
                            <MenuFlyoutItem
                                x:Uid="/Explorer/Flyout/NewFolderMFI"
                                Command="{x:Bind CreateChildFolderCommand, Mode=OneWay}"
                                Icon="NewFolder"
                                Text="New Folder" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />

                        <!--  Modify  -->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CutMFI"
                            Icon="Cut"
                            IsEnabled="False"
                            Text="Cut" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CopyMFI"
                            Command="{x:Bind CopyFileCommand, Mode=OneWay}"
                            Icon="Copy"
                            Text="Copy" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/PasteMFI"
                            Icon="Paste"
                            IsEnabled="False"
                            Text="Paste" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/DeleteMFI"
                            Command="{x:Bind DeleteCommand, Mode=OneWay}"
                            Icon="Delete"
                            Text="Delete" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/RenameMFI"
                            Click="RenameClicked"
                            Icon="Rename"
                            Text="Rename" />
                        <MenuFlyoutSeparator />

                        <!--  Open  -->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/OpenInFileExplorerMFI"
                            Command="{x:Bind OpenInExplorerCommand, Mode=OneWay}"
                            Text="Open in File Explorer">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED25;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <!--<MenuFlyoutItem x:Uid="/Explorer/Flyout/OpenInTerminal" Text="Open in Terminal" IsEnabled="False"/>-->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/OpenInWindowsTerminal"
                            Command="{x:Bind OpenInWindowsTerminalCommand, Mode=OneWay}"
                            Text="Open in Windows Terminal">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />

                        <!--  Copy Path  -->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CopyNameMFI"
                            Command="{x:Bind CopyFileNameCommand, Mode=OneWay}"
                            Text="Copy Name" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CopyFullPathMFI"
                            Command="{x:Bind CopyFilePathCommand, Mode=OneWay}"
                            Text="Copy Full Path">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE62F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </TreeViewItem.ContextFlyout>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ImageIcon Height="20" Source="{StaticResource FolderIcon}" />
                    <ctrls:EditableTextBlock Text="{x:Bind Name, Mode=TwoWay}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate" x:DataType="files:BindableFile">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                DoubleTapped="FileDoubleTapped"
                ItemsSource="{x:Bind Children, Mode=OneWay}">
                <TreeViewItem.ContextFlyout>
                    <MenuFlyout>
                        <!--  Open  -->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/OpenMFI"
                            Command="{x:Bind OpenCommand, Mode=OneWay}"
                            Icon="OpenFile"
                            Text="Open" />
                        <MenuFlyoutSubItem
                            x:Uid="/Explorer/Flyout/OpenWithMFSI"
                            IsEnabled="False"
                            Text="Open With" />
                        <MenuFlyoutSeparator />

                        <!--  Modify  -->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CutMFI"
                            Icon="Cut"
                            IsEnabled="False"
                            Text="Cut" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CopyMFI"
                            Command="{x:Bind CopyFileCommand, Mode=OneWay}"
                            Icon="Copy"
                            Text="Copy" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/DeleteMFI"
                            Command="{x:Bind DeleteCommand, Mode=OneWay}"
                            Icon="Delete"
                            Text="Delete" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/RenameMFI"
                            Click="RenameClicked"
                            Icon="Rename"
                            Text="Rename" />
                        <MenuFlyoutSeparator />

                        <!--  Copy Path  -->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CopyNameMFI"
                            Command="{x:Bind CopyFileNameCommand, Mode=OneWay}"
                            Text="Copy Name" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CopyFullPathMFI"
                            Command="{x:Bind CopyFilePathCommand, Mode=OneWay}"
                            Text="Copy Full Path">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE62F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </TreeViewItem.ContextFlyout>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ImageIcon Height="20" Source="{x:Bind Name, Converter={StaticResource FileTypeIconConverter}, Mode=OneWay}" />
                    <ctrls:EditableTextBlock Text="{x:Bind Name, Mode=TwoWay}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="ProjectTemplate" x:DataType="files:BindableProjectFile">
            <TreeViewItem
                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                DoubleTapped="FolderDoubleTapped"
                HasUnrealizedChildren="{x:Bind ChildrenNotLoaded, Mode=OneWay}"
                ItemsSource="{x:Bind Children, Mode=OneWay}"
                Loaded="TreeViewItem_Loaded">
                <TreeViewItem.ContextFlyout>
                    <MenuFlyout>
                        <!--  Add  -->
                        <MenuFlyoutSubItem x:Uid="/Explorer/Flyout/AddMFSI" Text="Add">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                            </MenuFlyoutSubItem.Icon>
                            <!--  File  -->
                            <MenuFlyoutItem
                                x:Uid="/Explorer/Flyout/NewFileMFI"
                                Command="{x:Bind CreateChildFileCommand, Mode=OneWay}"
                                Text="New File" />
                            <MenuFlyoutItem
                                x:Uid="/Explorer/Flyout/ExistingFileMFI"
                                IsEnabled="False"
                                Text="Existing File" />
                            <MenuFlyoutSeparator />

                            <!--  Folder  -->
                            <MenuFlyoutItem
                                x:Uid="/Explorer/Flyout/NewFolderMFI"
                                Command="{x:Bind CreateChildFolderCommand, Mode=OneWay}"
                                Icon="NewFolder"
                                Text="New Folder" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />

                        <!--  Copy Path  -->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CopyNameMFI"
                            Command="{x:Bind CopyFileNameCommand, Mode=OneWay}"
                            Text="Copy Name" />
                        <MenuFlyoutItem
                            x:Uid="/Explorer/Flyout/CopyFullPathMFI"
                            Command="{x:Bind CopyFilePathCommand, Mode=OneWay}"
                            Text="Copy Full Path">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE62F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />

                        <!--  Configure  -->
                        <MenuFlyoutItem
                            x:Uid="/Explorer/ConfigureMFI"
                            IsEnabled="False"
                            Text="Configure">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE90F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </TreeViewItem.ContextFlyout>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ImageIcon Height="20" Source="{x:Bind Name, Converter={StaticResource FileTypeIconConverter}, Mode=OneWay}" />
                    <ctrls:EditableTextBlock Text="{x:Bind Name, Mode=TwoWay}" />
                </StackPanel>
            </TreeViewItem>
        </DataTemplate>

        <selector:FileItemTemplateSelector
            x:Key="FileItemTemplateSelector"
            FileTemplate="{StaticResource FileTemplate}"
            FolderTemplate="{StaticResource FolderTemplate}"
            ProjectTemplate="{StaticResource ProjectTemplate}" />

    </UserControl.Resources>

    <Grid Margin="4,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--<AutoSuggestBox x:Uid="SearchFilesASB"
                        PlaceholderText="Search Files"
                        Margin="16,0,16,12"
                        IsEnabled="False"/>-->
        <TreeView
            x:Name="FilesTreeViewRoot"
            Grid.Row="1"
            x:Load="{x:Bind local:Explorer.IsNotNull(ViewModel.RootNode), FallbackValue=False, Mode=OneWay}"
            Expanding="TreeView_Expanding"
            ItemTemplateSelector="{StaticResource FileItemTemplateSelector}"
            ItemsSource="{x:Bind ViewModel.RootNode, Mode=OneWay}">
            <TreeView.ItemContainerTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </TreeView.ItemContainerTransitions>
        </TreeView>

        <StackPanel x:Name="RecentFileListView" x:Load="{x:Bind local:Explorer.IsNull(ViewModel.RootNode), FallbackValue=True, Mode=OneWay}">
            <TextBlock
                x:Uid="/Pages/Explorer/RecentProjectsAndFoldersTB"
                FontSize="22"
                Text="Recent Projects and Folders"
                TextTrimming="CharacterEllipsis" />
            <ItemsRepeater
                Grid.Row="1"
                Margin="0,8,0,16"
                ItemsSource="{x:Bind ViewModel.RecentProjects, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <HyperlinkButton
                            MinHeight="20"
                            Padding="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="RecentFileClicked"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind}">
                            <TextBlock
                                FontSize="12"
                                Text="{x:Bind local:Explorer.FormatPath((x:String)), Mode=OneWay}"
                                TextTrimming="None" />
                        </HyperlinkButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Button
                x:Uid="/Pages/Explorer/CreateNewProjectBTN"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.CreateNewProjectCommand, Mode=OneWay}"
                Content="Create New Project" />

        </StackPanel>
    </Grid>
</UserControl>
