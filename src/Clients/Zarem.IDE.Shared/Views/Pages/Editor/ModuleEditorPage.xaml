<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.IDE.Views.Pages.Editor.ModuleEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hexbox="using:HexBox.WinUI"
    xmlns:local="using:Zarem.IDE.Views.Pages.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:tabs="using:Zarem.Models.Tables"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:Zarem.IDE.Helpers"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--  Symbol Table  -->
        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Uid="/Pages/ModuleEditor/SymbolTableTB" Text="Symbol Table" FontSize="24" FontWeight="SemiBold" Margin="10,8"/>
            <ListView ItemsSource="{x:Bind Symbols, Mode=OneWay}" Grid.Row="1">
                <ListView.Header>
                    <Border Padding="8,4,8,4" CornerRadius="4">
                        <ctc:DataTable>
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/SymbolNameDC"
                                Content="Symbol Name"
                                CanResize="True"
                                MinWidth="80"
                                DesiredWidth="240" />
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/SectionDC"
                                Content="Section"
                                CanResize="True"
                                MinWidth="40"
                                DesiredWidth="100" />
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/OffsetDC"
                                Content="Offset"
                                CanResize="True"
                                MinWidth="40"
                                DesiredWidth="100" />
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/BindingDC"
                                Content="Binding"
                                CanResize="True"
                                MinWidth="40"
                                DesiredWidth="100" />
                        </ctc:DataTable>
                    </Border>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="tabs:Symbol">
                        <ctc:DataRow HorizontalAlignment="Left">
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind Address.Section.Name, Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind local:ModuleEditorPage.FormatOffset(Address), Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind helpers:LocalizationHelper.Localize(Binding), Mode=OneWay}" />
                        </ctc:DataRow>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!--  Relocation Table  -->
        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8"
              Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Uid="/Pages/ModuleEditor/RelocationTableTB" Text="Relocation Table" FontSize="24" FontWeight="SemiBold" Margin="10,8"/>
            <ListView ItemsSource="{x:Bind Relocations, Mode=OneWay}" Grid.Row="1">
                <ListView.Header>
                    <Border Padding="8,4,8,4" CornerRadius="4">
                        <ctc:DataTable>
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/SectionDC"
                                Content="Section"
                                CanResize="True"
                                MinWidth="40"
                                DesiredWidth="100" />
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/OffsetDC"
                                Content="Offset"
                                CanResize="True"
                                MinWidth="40"
                                DesiredWidth="100" />
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/SymbolReferencedDC"
                                Content="Symbol Referenced"
                                CanResize="True"
                                MinWidth="80"
                                DesiredWidth="240" />
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/TypeDC"
                                Content="Type"
                                CanResize="True"
                                MinWidth="40"
                                DesiredWidth="100" />
                            <ctc:DataColumn
                                x:Uid="/Pages/ModuleEditor/AddendDC"
                                Content="Addend"
                                CanResize="True"
                                MinWidth="40"
                                DesiredWidth="100" />
                        </ctc:DataTable>
                    </Border>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="tabs:RelocationEntry">
                        <ctc:DataRow HorizontalAlignment="Left">
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind Location.Section.Name, Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind local:ModuleEditorPage.FormatOffset(Location), Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind SymbolName, Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind Type, Mode=OneWay}" />
                            <TextBlock
                                Margin="8,0"
                                Text="{x:Bind Addend, Mode=OneWay}" />
                        </ctc:DataRow>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="MinHeight" Value="28" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
