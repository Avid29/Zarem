<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.IDE.Views.Shell.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:debugenum="using:Zarem.Debugger.Models.Enums"
    xmlns:editenum="using:Zarem.IDE.Messages.Editor.Enums"
    xmlns:local="using:Zarem.IDE.Views.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="MenuBar">
                <Setter Property="MinHeight" Value="8" />
            </Style>
            <Style TargetType="MenuBarItem">
                <Setter Property="Margin" Value="0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Title Bar  -->
    <Grid Padding="4,0" Background="{ThemeResource TitleBarBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!--  App Icon  -->
            <ColumnDefinition Width="auto" />

            <!--  Menu Bar  -->
            <ColumnDefinition Width="auto" />

            <!--  Gap  -->
            <ColumnDefinition />

            <!--  Settings Button  -->
            <ColumnDefinition Width="auto" />
            <!--<ColumnDefinition x:Name="CaptionButtonColumn"/>-->
        </Grid.ColumnDefinitions>

        <ImageIcon
            Height="18"
            Margin="8,4,8,2"
            VerticalAlignment="Center"
            Source="{StaticResource AppIconSmall}" />

        <MenuBar
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <!--  File  -->
            <MenuBarItem x:Uid="/TitleBar/FileMBI" Title="File">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Menu" />
                </MenuBarItem.KeyboardAccelerators>
                <!--  New  -->
                <MenuFlyoutSubItem x:Uid="/TitleBar/NewMFSI" Text="New">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE109;" />
                    </MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/NewProjectMFI"
                        Command="{x:Bind ViewModel.OpenCreateProjectCommand}"
                        Text="New Project">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/NewFileMFI"
                        Command="{x:Bind ViewModel.MainViewModel.ExplorerViewModel.CreateNewFileCommand}"
                        IsEnabled="{x:Bind local:TitleBar.IsNotNull(ViewModel.MainViewModel.ExplorerViewModel.RootNode), FallbackValue=False, Mode=OneWay}"
                        Text="New File">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE130;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>

                <!--  Open  -->
                <MenuFlyoutSubItem x:Uid="/TitleBar/OpenMFSI" Text="Open">
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/OpenProjectMFI"
                        Command="{x:Bind ViewModel.PickAndOpenProjectCommand}"
                        Text="Open Project">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/OpenFolderMFI"
                        Command="{x:Bind ViewModel.PickAndOpenFolderCommand}"
                        Icon="OpenLocal"
                        Text="Open Folder">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control,Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem
                        x:Uid="/TitleBar/OpenFileMFI"
                        Command="{x:Bind ViewModel.PickAndOpenFileCommand}"
                        Icon="OpenFile"
                        Text="Open File">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />

                <!--  Save  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/SaveFileMFI"
                    Command="{x:Bind ViewModel.SaveFileCommand}"
                    Icon="Save"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanSave, FallbackValue=False, Mode=OneWay}"
                    Text="Save File">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/SaveAllMFI"
                    Command="{x:Bind ViewModel.SaveAllFilesCommand}"
                    Text="Save All">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA35;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />

                <!--  Close  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/ClosePageMFI"
                    Command="{x:Bind ViewModel.ClosePageCommand}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.IsPageOpen, FallbackValue=False, Mode=OneWay}"
                    Text="Close Page">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/CloseProjectMFI"
                    Command="{x:Bind ViewModel.CloseProjectCommand}"
                    IsEnabled="{x:Bind local:TitleBar.IsNotNull(ViewModel.MainViewModel.ExplorerViewModel.RootNode), FallbackValue=False, Mode=OneWay}"
                    Text="Close Project" />
            </MenuBarItem>

            <!--  Edit  -->
            <MenuBarItem x:Uid="/TitleBar/EditMBI" Title="Edit">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="E" Modifiers="Menu" />
                </MenuBarItem.KeyboardAccelerators>
                <!--  History  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/UndoMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.Undo}"
                    Icon="Undo"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Undo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/RedoMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.Redo}"
                    Icon="Redo"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Redo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control" />
                        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />

                <!--  Basic  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/CutMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.Cut}"
                    Icon="Cut"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Cut">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="X" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/CopyMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.Copy}"
                    Icon="Copy"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Copy">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/PasteMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.Paste}"
                    Icon="Paste"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Paste">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/DuplicateMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.Duplicate}"
                    Icon="Copy"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Duplicate">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />

                <!--  Select  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/SelectAllMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.SelectAll}"
                    Icon="SelectAll"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Select All">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />

                <!--  Advanced  -->
                <MenuFlyoutSubItem
                    x:Uid="/TitleBar/EditorAdvancedMFSI"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Advanced">
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/MoveLineUpMFI"
                        Command="{x:Bind ViewModel.SendEditOperationCommand}"
                        CommandParameter="{x:Bind editenum:EditorOperation.TransposeUp}"
                        Text="Move Line Up">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/MoveLineDownMFI"
                        Command="{x:Bind ViewModel.SendEditOperationCommand}"
                        CommandParameter="{x:Bind editenum:EditorOperation.TransposeDown}"
                        Text="Move Line Down">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Down" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem
                    x:Uid="/TitleBar/OutliningMFSI"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanTextEdit, FallbackValue=False, Mode=OneWay}"
                    Text="Outlining">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF168;" />
                    </MenuFlyoutSubItem.Icon>
                    <!--<MenuFlyoutItem x:Uid="/TitleBar/ToggleOutliningMFI" Text="Toggle Outlining"/>-->
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/ExpandCurrentMFI"
                        Command="{x:Bind ViewModel.SendEditOperationCommand}"
                        CommandParameter="{x:Bind editenum:EditorOperation.ExpandChildren}"
                        Text="Expand Current">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{StaticResource ExpandCurrentIcon}" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/CollapseCurrentMFI"
                        Command="{x:Bind ViewModel.SendEditOperationCommand}"
                        CommandParameter="{x:Bind editenum:EditorOperation.CollapseChildren}"
                        Text="Collapse Current">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{StaticResource CollapseCurrentIcon}" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="P" Modifiers="Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/ExpandAllMFI"
                        Command="{x:Bind ViewModel.SendEditOperationCommand}"
                        CommandParameter="{x:Bind editenum:EditorOperation.ExpandAll}"
                        Text="Expand All">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{StaticResource ExpandAllIcon}" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Shift,Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="/TitleBar/CollapseAllMFI"
                        Command="{x:Bind ViewModel.SendEditOperationCommand}"
                        CommandParameter="{x:Bind editenum:EditorOperation.CollapseAll}"
                        Text="Collapse All">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{StaticResource CollapseAllIcon}" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="P" Modifiers="Shift,Menu" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
            </MenuBarItem>

            <!--  View  -->
            <!--<MenuBarItem x:Uid="/TitleBar/ViewMBI" Title="View">
            -->
            <!--<MenuFlyoutItem x:Uid="/TitleBar/ToggleFullScreenMFI" Text="Toggle Full Screen"
                                Command="{x:Bind ViewModel.ToggleFullScreenModeCommand, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="F12"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>-->
            <!--
                <MenuFlyoutItem Text="Show Console" Command="{x:Bind ViewModel.ShowConsoleCommand, Mode=OneWay}"/>
            </MenuBarItem>-->

            <!--  Build  -->
            <MenuBarItem x:Uid="/TitleBar/BuildMBI" Title="Build">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="B" Modifiers="Menu" />
                </MenuBarItem.KeyboardAccelerators>
                <!--  Build/Rebuild  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/BuildProjectMFI"
                    Command="{x:Bind ViewModel.BuildProjectCommand}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsReady, Mode=OneWay}"
                    Text="Build Project">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource BuildIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/RebuildProjectMFI"
                    Command="{x:Bind ViewModel.RebuildProjectCommand}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsReady, Mode=OneWay}"
                    Text="Rebuild Project">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource ReBuildIcon}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />

                <!--  Assemble  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/AssembleFileMFI"
                    Command="{x:Bind ViewModel.AssembleFileCommand}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanAssemble, FallbackValue=False, Mode=OneWay}"
                    Text="Assemble File">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />

                <!--  Clean  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/CleanProjectMFI"
                    Command="{x:Bind ViewModel.CleanProjectCommand}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsReady, Mode=OneWay}"
                    Text="Clean Project">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource CleanIcon}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/CleanFileMFI"
                    Command="{x:Bind ViewModel.CleanFileCommand}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanAssemble, FallbackValue=False, Mode=OneWay}"
                    Text="Clean File" />
            </MenuBarItem>

            <!--  Debug  -->
            <MenuBarItem x:Uid="/TitleBar/DebugMBI" Title="Debug">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="D" Modifiers="Menu" />
                </MenuBarItem.KeyboardAccelerators>
                <!--  Run  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/StartDebuggingMFI"
                    Command="{x:Bind ViewModel.StartDebuggingCommand}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsReady, Mode=OneWay}"
                    Text="Start Debugging"
                    Visibility="{x:Bind local:TitleBar.VisibleIfNot(ViewModel.MainViewModel.StatusViewModel.IsRunning), Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StartDebuggingIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/StartWithoutDebuggingMFI"
                    Command="{x:Bind ViewModel.StartWithoutDebuggingCommand}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsReady, Mode=OneWay}"
                    Text="Start Without Debugging"
                    Visibility="{x:Bind local:TitleBar.VisibleIfNot(ViewModel.MainViewModel.StatusViewModel.IsRunning), Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StartWithoutDebuggingIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>

                <MenuFlyoutItem
                    x:Uid="/TitleBar/ContinueMFI"
                    Command="{x:Bind ViewModel.StepCommand}"
                    CommandParameter="{x:Bind debugenum:StepMode.Continue}"
                    Text="Continue"
                    Visibility="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsRunning, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StartDebuggingIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/StopDebuggingMFI"
                    Command="{x:Bind ViewModel.StopDebuggingCommand}"
                    Text="Stop Debugging"
                    Visibility="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsRunning, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StopDebuggingIcon}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />

                <!--  Run File  -->
                <!--<MenuFlyoutItem x:Uid="/TitleBar/StartDebuggingFileMFI" Text="Start Debugging File"
                                Command="{x:Bind ViewModel.StartFileWithoutDebuggingCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.PanelViewModel.CurrentPage.CanAssemble, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StartDebuggingIcon}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="/TitleBar/StartFileWithoutDebuggingMFI" Text="Start File Without Debugging"
                                Command="{x:Bind ViewModel.StartFileWithoutDebuggingCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.PanelViewModel.CurrentPage.CanAssemble, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StartWithoutDebuggingIcon}"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>-->

                <!--  Step  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/StepMFI"
                    Command="{x:Bind ViewModel.StepCommand}"
                    CommandParameter="{x:Bind debugenum:StepMode.Step}"
                    Text="Step"
                    Visibility="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsRunning, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StepIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F10" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/StepOverMFI"
                    Command="{x:Bind ViewModel.StepCommand}"
                    CommandParameter="{x:Bind debugenum:StepMode.StepOver}"
                    Text="Step Over"
                    Visibility="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsRunning, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StepOverIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F11" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/StepOutMFI"
                    Command="{x:Bind ViewModel.StepCommand}"
                    CommandParameter="{x:Bind debugenum:StepMode.StepOut}"
                    Text="Step Out"
                    Visibility="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsRunning, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource StepOutIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F11" Modifiers="Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.MainViewModel.StatusViewModel.IsRunning, Mode=OneWay}" />

                <!--  Breakpoints  -->
                <MenuFlyoutItem
                    x:Uid="/TitleBar/ToggleBreakpointMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.ToggleBreakpoint}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanAssemble, FallbackValue=False, Mode=OneWay}"
                    Text="Toggle Breakpoint">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource ToggleBreakpointIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F9" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/ClearBreakpointsMFI"
                    Command="{x:Bind ViewModel.SendEditOperationCommand}"
                    CommandParameter="{x:Bind editenum:EditorOperation.ClearBreakpoints}"
                    IsEnabled="{x:Bind ViewModel.MainViewModel.FocusedPanel.CurrentPage.CanAssemble, FallbackValue=False, Mode=OneWay}"
                    Text="Clear Breakpoints">
                    <MenuFlyoutItem.Icon>
                        <ImageIcon Source="{StaticResource ClearBreakpointsIcon}" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F9" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <!--  Help  -->
            <MenuBarItem x:Uid="/TitleBar/HelpMBI" Title="Help">
                <MenuBarItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="H" Modifiers="Menu" />
                </MenuBarItem.KeyboardAccelerators>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/MIPSCheatSheetMFI"
                    Command="{x:Bind ViewModel.OpenMIPSCheatSheetCommand, Mode=OneWay}"
                    Text="Show MIPS Cheatsheet">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF7DB;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Name="WikiMFI"
                    x:Uid="/TitleBar/OpenWikiMFI"
                    Click="WikiMFI_Click"
                    Text="Open Wiki">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF6FA;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="ReportBugMFI"
                    x:Uid="/TitleBar/ReportBugMFI"
                    Click="ReportBugMFI_Click"
                    Text="Report a Bug">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE730;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Uid="/TitleBar/WelcomeMFI"
                    Command="{x:Bind ViewModel.OpenWelcomeCommand, Mode=OneWay}"
                    Text="Open Welcome Page" />
                <MenuFlyoutItem
                    x:Uid="/TitleBar/SettingsMFI"
                    Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}"
                    Text="Zarem Settings">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="/TitleBar/AboutMFI"
                    Command="{x:Bind ViewModel.OpenAboutCommand, Mode=OneWay}"
                    Text="About Zarem">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <Button
            Grid.Column="3"
            Width="36"
            Margin="0,4"
            Padding="0"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind ViewModel.OpenSettingsCommand, Mode=OneWay}">
            <Viewbox Height="16">
                <SymbolIcon Symbol="Setting" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
