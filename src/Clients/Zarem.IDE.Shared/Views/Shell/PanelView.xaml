<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.IDE.Views.Shell.PanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cheatpages="using:Zarem.IDE.Views.Pages.CheatSheet"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Zarem.IDE.Views.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:Zarem.IDE.Views.Pages"
    xmlns:selectors="using:Zarem.IDE.Selectors"
    xmlns:spages="using:Zarem.IDE.Views.Pages.Settings"
    xmlns:svmv="using:Zarem.IDE.ViewModels.Pages.Settings"
    xmlns:vmcheat="using:Zarem.IDE.ViewModels.Pages.CheatSheet"
    xmlns:vmv="using:Zarem.IDE.ViewModels.Pages"
    xmlns:vmva="using:Zarem.IDE.ViewModels.Pages.Abstract"
    GotFocus="UserControl_GotFocus"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="PageHeaderTemplate" x:DataType="vmva:PageViewModel">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontStyle="{x:Bind local:PanelView.UseItalics(IsDirty), Mode=OneWay}" Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock
                    FontStyle="Italic"
                    Text="*"
                    Visibility="{x:Bind IsDirty, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <selectors:PageTemplateSelector x:Key="PageTemplateSelector">
            <selectors:PageTemplateSelector.AboutPageTemplate>
                <DataTemplate x:DataType="vmv:AboutPageViewModel">
                    <TabViewItem HeaderTemplate="{StaticResource PageHeaderTemplate}">
                        <pages:AboutPage ViewModel="{x:Bind Mode=OneWay}" />
                    </TabViewItem>
                </DataTemplate>
            </selectors:PageTemplateSelector.AboutPageTemplate>
            <selectors:PageTemplateSelector.CheatSheetPageTemplate>
                <DataTemplate x:DataType="vmcheat:CheatSheetViewModel">
                    <TabViewItem HeaderTemplate="{StaticResource PageHeaderTemplate}">
                        <cheatpages:CheatSheetPage ViewModel="{x:Bind Mode=OneWay}" />
                    </TabViewItem>
                </DataTemplate>
            </selectors:PageTemplateSelector.CheatSheetPageTemplate>
            <selectors:PageTemplateSelector.CreateProjectPageTemplate>
                <DataTemplate x:DataType="vmv:CreateProjectViewModel">
                    <TabViewItem HeaderTemplate="{StaticResource PageHeaderTemplate}">
                        <pages:CreateProject ViewModel="{x:Bind Mode=OneWay}" />
                    </TabViewItem>
                </DataTemplate>
            </selectors:PageTemplateSelector.CreateProjectPageTemplate>
            <selectors:PageTemplateSelector.FilePageTemplate>
                <DataTemplate x:DataType="vmv:FilePageViewModel">
                    <TabViewItem HeaderTemplate="{StaticResource PageHeaderTemplate}">
                        <pages:FileViewer ViewModel="{x:Bind Mode=OneWay}" />
                    </TabViewItem>
                </DataTemplate>
            </selectors:PageTemplateSelector.FilePageTemplate>
            <selectors:PageTemplateSelector.SettingsPageTemplate>
                <DataTemplate x:DataType="svmv:SettingsPageViewModel">
                    <TabViewItem HeaderTemplate="{StaticResource PageHeaderTemplate}">
                        <spages:SettingsPage ViewModel="{x:Bind Mode=OneWay}" />
                    </TabViewItem>
                </DataTemplate>
            </selectors:PageTemplateSelector.SettingsPageTemplate>
            <selectors:PageTemplateSelector.WelcomePageTemplate>
                <DataTemplate x:DataType="vmv:WelcomePageViewModel">
                    <TabViewItem HeaderTemplate="{StaticResource PageHeaderTemplate}">
                        <pages:WelcomePage ViewModel="{x:Bind Mode=OneWay}" />
                    </TabViewItem>
                </DataTemplate>
            </selectors:PageTemplateSelector.WelcomePageTemplate>
        </selectors:PageTemplateSelector>
    </UserControl.Resources>

    <TabView
        VerticalAlignment="Stretch"
        IsAddTabButtonVisible="False"
        SelectedItem="{x:Bind ViewModel.CurrentPage, Mode=TwoWay}"
        TabCloseRequested="TabView_TabCloseRequested"
        TabDroppedOutside="TabView_TabDroppedOutside"
        TabItemTemplateSelector="{StaticResource PageTemplateSelector}"
        TabItemsSource="{x:Bind ViewModel.OpenPages, Mode=OneWay}"
        TabWidthMode="SizeToContent">
        <TabView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <AcrylicBrush
                            x:Key="TabViewBackground"
                            TintColor="{ThemeResource TabViewBackgroundColor}"
                            TintOpacity="0.8" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <AcrylicBrush
                            x:Key="TabViewBackground"
                            TintColor="{ThemeResource TabViewBackgroundColor}"
                            TintOpacity="0.8" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </TabView.Resources>
    </TabView>
</UserControl>
