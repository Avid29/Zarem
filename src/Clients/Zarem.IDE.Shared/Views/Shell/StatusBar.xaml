<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Zarem.IDE.Views.Shell.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Zarem.IDE.Controls"
    xmlns:convert="using:Zarem.IDE.Converters"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:cth="using:CommunityToolkit.WinUI.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Zarem.IDE.Helpers"
    xmlns:local="using:Zarem.IDE.Views.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <convert:AppStatusColorConverter
            x:Key="AppStatusColorConverter"
            Building="{ThemeResource BuildingStatusBarBackgroundColor}"
            Done="{ThemeResource DoneStatusBarBackgroundColor}"
            Failed="{ThemeResource FailedStatusBarBackgroundColor}"
            NotReady="{ThemeResource NotReadyStatusBarBackgroundColor}"
            Ready="{ThemeResource ReadyStatusBarBackgroundColor}"
            Running="{ThemeResource RunningStatusBarBackgroundColor}" />
    </UserControl.Resources>

    <Grid>
        <!--<controls:RunningIndicator Margin="0,-36,0,0"/>-->
        <Grid Padding="8,0,8,2">
            <Grid.Background>
                <SolidColorBrush x:Name="BackgroundBrush" Color="{x:Bind ViewModel.State, Converter={StaticResource AppStatusColorConverter}, Mode=OneWay}" />
            </Grid.Background>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    cth:ContrastHelper.Opponent="{x:Bind BackgroundBrush.Color, Mode=OneWay}"
                    Text="{x:Bind helpers:LocalizationHelper.Localize(ViewModel.State), Mode=OneWay}" />

                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    cth:ContrastHelper.Opponent="{x:Bind BackgroundBrush.Color, Mode=OneWay}"
                    FontSize="12"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
